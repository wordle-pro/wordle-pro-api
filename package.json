{
  "name": "wordle-pro-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch --env-file=.env.development src/server.ts",
    "preview": "node --env-file=.env.production dist/server.js",
    "build": "pnpm run clean && esbuild src/server.ts --bundle --splitting --platform=node --format=esm --packages=external --alias:@=./src --outdir=dist",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new-migration": "supabase migration new",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "db:lint": "supabase db lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hchan07/wordle-pro-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/hchan07/wordle-pro-api/issues"
  },
  "homepage": "https://github.com/hchan07/wordle-pro-api#readme",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^6.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.49",
    "@supabase/supabase-js": "^2.112.2",
    "fastify": "^5.8.5",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "supabase": "^1.192.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
